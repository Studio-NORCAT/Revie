<Window x:Class="Revie.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="#01000000"
        ShowInTaskbar="False"
        Topmost="True"
        Left="0"
        Top="0"
        Width="800"
        Height="600">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#E5121212" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#3A3A3A" />
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#232323" />
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#2D2D2D" />
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#4A4A4A" />

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="#F0F0F0" />
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#181818" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarToggleStyle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="#F0F0F0" />
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#353535" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#868686" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,4" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#AFAFAF" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style x:Key="ColorSwatchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="BorderBrush" Value="#202020" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <Border x:Name="SelectionRing"
                                    CornerRadius="15"
                                    Background="#12000000"
                                    BorderBrush="Transparent"
                                    BorderThickness="1.5" />
                            <Border x:Name="Swatch"
                                    Margin="3"
                                    CornerRadius="12"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionRing" Property="BorderBrush" Value="#6C6C6C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Swatch" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectionRing" Property="BorderBrush" Value="#F3F3F3" />
                                <Setter TargetName="SelectionRing" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SizeToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource ToolbarToggleStyle}">
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="IconToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource ToolbarToggleStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Resources>

    <Grid x:Name="OverlayRoot" Background="#01000000">
        <InkCanvas x:Name="InkSurface" Background="#01000000" />

        <Border x:Name="ToolbarRoot"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="14"
                Padding="12"
                MinWidth="280"
                CornerRadius="12"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                Visibility="Collapsed">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="True">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" FontSize="14" Foreground="#EFEFEF" Text="Revie Tools" />
                    <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#B8B8B8" Text="Draw on screen (Ctrl+Shift+D to toggle)" />

                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Color" />
                    <WrapPanel>
                        <ToggleButton x:Name="RedColorButton"
                                      Tag="#FFFF0000"
                                      Style="{StaticResource ColorSwatchStyle}"
                                      Background="#FFFF0000"
                                      ToolTip="Red pen"
                                      Click="ColorButton_OnClick" />
                        <ToggleButton x:Name="GreenColorButton"
                                      Tag="#FF00B050"
                                      Style="{StaticResource ColorSwatchStyle}"
                                      Background="#FF00B050"
                                      ToolTip="Green pen"
                                      Click="ColorButton_OnClick" />
                        <ToggleButton x:Name="BlueColorButton"
                                      Tag="#FF0070FF"
                                      Style="{StaticResource ColorSwatchStyle}"
                                      Background="#FF0070FF"
                                      ToolTip="Blue pen"
                                      Click="ColorButton_OnClick" />
                        <ToggleButton x:Name="YellowColorButton"
                                      Tag="#FFFFEA00"
                                      Style="{StaticResource ColorSwatchStyle}"
                                      Background="#FFFFEA00"
                                      BorderBrush="#A48A00"
                                      ToolTip="Yellow pen"
                                      Click="ColorButton_OnClick" />
                        <ToggleButton x:Name="WhiteColorButton"
                                      Tag="#FFFFFFFF"
                                      Style="{StaticResource ColorSwatchStyle}"
                                      Background="#FFFFFFFF"
                                      ToolTip="White pen"
                                      Click="ColorButton_OnClick" />
                        <ToggleButton x:Name="BlackColorButton"
                                      Tag="#FF000000"
                                      Style="{StaticResource ColorSwatchStyle}"
                                      Background="#FF000000"
                                      BorderBrush="#666666"
                                      ToolTip="Black pen"
                                      Click="ColorButton_OnClick" />
                        <ToggleButton x:Name="CustomColorButton"
                                      Tag="Custom"
                                      Style="{StaticResource ColorSwatchStyle}"
                                      Background="#FFFFEA00"
                                      BorderBrush="#A48A00"
                                      ToolTip="Use custom color"
                                      Click="CustomColorSelect_OnClick" />
                        <Button Style="{StaticResource IconButtonStyle}"
                                Margin="0,0,0,6"
                                ToolTip="Pick custom color"
                                Click="CustomColorPickerButton_OnClick">
                            <Grid Width="16" Height="16">
                                <Path Data="M 8,2 L 8,14 M 2,8 L 14,8"
                                      Stroke="#EAEAEA"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Grid>
                        </Button>
                    </WrapPanel>

                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Brush Size" />
                    <WrapPanel>
                        <ToggleButton x:Name="SmallSizeButton"
                                      Tag="Small"
                                      Style="{StaticResource SizeToggleStyle}"
                                      ToolTip="Small stroke"
                                      Click="SizeButton_OnClick">
                            <Ellipse Width="6" Height="6" Fill="#F0F0F0" />
                        </ToggleButton>
                        <ToggleButton x:Name="MediumSizeButton"
                                      Tag="Medium"
                                      Style="{StaticResource SizeToggleStyle}"
                                      ToolTip="Medium stroke"
                                      Click="SizeButton_OnClick">
                            <Ellipse Width="10" Height="10" Fill="#F0F0F0" />
                        </ToggleButton>
                        <ToggleButton x:Name="LargeSizeButton"
                                      Tag="Large"
                                      Style="{StaticResource SizeToggleStyle}"
                                      Margin="0"
                                      ToolTip="Large stroke"
                                      Click="SizeButton_OnClick">
                            <Ellipse Width="14" Height="14" Fill="#F0F0F0" />
                        </ToggleButton>
                    </WrapPanel>

                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Actions" />
                    <WrapPanel Margin="0,0,0,0">
                        <ToggleButton x:Name="EraserToggle"
                                      Style="{StaticResource IconToggleStyle}"
                                      Margin="0,0,8,0"
                                      ToolTip="Eraser"
                                      Checked="EraserToggle_OnChecked"
                                      Unchecked="EraserToggle_OnUnchecked">
                            <Grid Width="16" Height="16">
                                <Path Data="M 3,11 L 8.5,3.5 C 9.2,2.6 10.5,2.5 11.3,3.3 L 13.5,5.5 C 14.3,6.3 14.2,7.6 13.3,8.3 L 7.4,13 L 3,13 Z"
                                      Fill="#EAEAEA" />
                                <Path Data="M 6.3,12.9 L 11.3,6.2"
                                      Stroke="#161616"
                                      StrokeThickness="1.1"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Grid>
                        </ToggleButton>
                        <Button Style="{StaticResource IconButtonStyle}"
                                ToolTip="Clear drawing"
                                Click="ClearButton_OnClick">
                            <Grid Width="16" Height="16">
                                <Path Data="M 5,5 L 11,5 M 6,5 L 6,13 M 10,5 L 10,13 M 4,5 L 4,14 L 12,14 L 12,5 M 3,5 L 13,5 M 6,3 L 10,3"
                                      Stroke="#EAEAEA"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Grid>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
