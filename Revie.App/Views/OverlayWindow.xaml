<Window x:Class="Revie.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="#01000000"
        ShowInTaskbar="False"
        Topmost="True"
        Left="0"
        Top="0"
        Width="800"
        Height="600">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#E5121212" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#3A3A3A" />
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#232323" />
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#2D2D2D" />
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#4A4A4A" />

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="#F0F0F0" />
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#181818" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarToggleStyle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="#F0F0F0" />
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#353535" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#868686" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorSwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="BorderBrush" Value="#202020" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Swatch"
                                CornerRadius="13"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Swatch" Property="BorderBrush" Value="#E4E4E4" />
                                <Setter TargetName="Swatch" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Swatch" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="OverlayRoot" Background="#01000000">
        <InkCanvas x:Name="InkSurface" Background="#01000000" />

        <Border x:Name="ToolbarRoot"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="14"
                Padding="12"
                MinWidth="280"
                CornerRadius="12"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                Visibility="Collapsed">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="True">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" FontSize="14" Foreground="#EFEFEF" Text="Revie Tools" />
                    <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#B8B8B8" Text="Draw on screen (Ctrl+Shift+D to toggle)" />

                    <UniformGrid Margin="0,10,0,0"
                                 Rows="1"
                                 Columns="6"
                                 Width="180"
                                 HorizontalAlignment="Left">
                        <Button Tag="#FFFF0000"
                                Style="{StaticResource ColorSwatchStyle}"
                                Background="#FFFF0000"
                                Click="ColorButton_OnClick" />
                        <Button Tag="#FF00B050"
                                Style="{StaticResource ColorSwatchStyle}"
                                Background="#FF00B050"
                                Click="ColorButton_OnClick" />
                        <Button Tag="#FF0070FF"
                                Style="{StaticResource ColorSwatchStyle}"
                                Background="#FF0070FF"
                                Click="ColorButton_OnClick" />
                        <Button Tag="#FFFFEA00"
                                Style="{StaticResource ColorSwatchStyle}"
                                Background="#FFFFEA00"
                                BorderBrush="#A48A00"
                                Click="ColorButton_OnClick" />
                        <Button Tag="#FFFFFFFF"
                                Style="{StaticResource ColorSwatchStyle}"
                                Background="#FFFFFFFF"
                                Click="ColorButton_OnClick" />
                        <Button Tag="#FF000000"
                                Style="{StaticResource ColorSwatchStyle}"
                                Background="#FF000000"
                                BorderBrush="#666666"
                                Click="ColorButton_OnClick" />
                    </UniformGrid>

                    <WrapPanel Margin="0,2,0,0">
                        <Button Tag="Small" Margin="0,0,6,6" Style="{StaticResource ToolbarButtonStyle}" Content="Small" Click="SizeButton_OnClick" />
                        <Button Tag="Medium" Margin="0,0,6,6" Style="{StaticResource ToolbarButtonStyle}" Content="Medium" Click="SizeButton_OnClick" />
                        <Button Tag="Large" Margin="0,0,0,6" Style="{StaticResource ToolbarButtonStyle}" Content="Large" Click="SizeButton_OnClick" />
                    </WrapPanel>

                    <WrapPanel Margin="0,4,0,0">
                        <ToggleButton x:Name="EraserToggle"
                                      Style="{StaticResource ToolbarToggleStyle}"
                                      Margin="0,0,8,0"
                                      Content="Eraser"
                                      Checked="EraserToggle_OnChecked"
                                      Unchecked="EraserToggle_OnUnchecked" />
                        <Button Style="{StaticResource ToolbarButtonStyle}" Content="Clear" Click="ClearButton_OnClick" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
