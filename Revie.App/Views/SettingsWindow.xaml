<Window x:Class="Revie.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Revie Settings"
        Icon="/Assets/revie.ico"
        Width="860"
        Height="700"
        MinWidth="760"
        MinHeight="620"
        Background="#101010"
        Foreground="#E8E8E8"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#151515" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1A1A1A" />
        <SolidColorBrush x:Key="ControlBrush" Color="#1E1E1E" />
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#2A2A2A" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3A3A3A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#B0B0B0" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#141414" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="Foreground" Value="#ECECEC" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TextBoxRoot" Property="BorderBrush" Value="#5B5B5B" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxRoot" Property="BorderBrush" Value="#707070" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TextBoxRoot" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E9E9E9" />
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2E2E2E" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3B3B3B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="Foreground" Value="#ECECEC" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboRoot"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" />
                            <Grid Margin="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Margin="10,0,4,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                <Border Grid.Column="1" Background="#272727" CornerRadius="0,7,7,0">
                                    <TextBlock Text="&#xE70D;"
                                               FontFamily="Segoe MDL2 Assets"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="#D7D7D7" />
                                </Border>
                            </Grid>
                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Margin="0,6,0,0"
                                        Background="#181818"
                                        BorderBrush="#3F3F3F"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="280" CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboRoot" Property="BorderBrush" Value="#595959" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboRoot" Property="BorderBrush" Value="#6A6A6A" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboRoot" Property="BorderBrush" Value="#8F8F8F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#F1F1F1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="#1E1E1E" CornerRadius="6">
                            <ContentPresenter Margin="4,0,4,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2B2B2B" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3A3A3A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#171717" />
            <Setter Property="Foreground" Value="#F1F1F1" />
            <Setter Property="BorderBrush" Value="#353535" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer Focusable="False"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0"
                                      x:Name="HeaderPanel"
                                      IsItemsHost="True"
                                      Margin="0,0,0,-1"
                                      Panel.ZIndex="2" />
                            <Border Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0,10,10,10"
                                    Padding="{TemplateBinding Padding}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Focusable="False">
                                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                                      ContentSource="SelectedContent" />
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#D3D3D3" />
            <Setter Property="Background" Value="#1B1B1B" />
            <Setter Property="BorderBrush" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="MinWidth" Value="146" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root"
                                Margin="0,0,8,0"
                                CornerRadius="8,8,0,0"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2F2F2F" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#7B7B7B" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="Root" Property="Margin" Value="0,0,8,-1" />
                                <Setter TargetName="Root" Property="BorderThickness" Value="1,1,1,0" />
                                <Setter Property="Panel.ZIndex" Value="3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Revie Settings" />
                <TextBlock Margin="0,4,0,12"
                           Foreground="{StaticResource MutedBrush}"
                           Text="Configure general behavior, hotkeys, and project grouping." />
            </StackPanel>
            <Border Grid.Column="1"
                    VerticalAlignment="Top"
                    Padding="10,6"
                    Background="#1A1A1A"
                    BorderBrush="#3A3A3A"
                    BorderThickness="1"
                    CornerRadius="8">
                <TextBlock x:Name="VersionTextBlock"
                           Foreground="#D8D8D8"
                           FontWeight="SemiBold"
                           Text="Version" />
            </Border>
        </Grid>

        <TabControl Grid.Row="1">
                <TabItem Header="General">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource MutedBrush}" Text="Storage Root (local or UNC path)" />
                                <TextBox x:Name="StorageRootTextBox" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Margin="10,23,0,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Browse..."
                                    Click="BrowseStorageButton_OnClick" />
                        </Grid>

                        <CheckBox x:Name="ClearOverlayAfterCaptureCheckBox"
                                  Grid.Row="1"
                                  Margin="0,16,0,0"
                                  Content="Clear overlay after screenshot" />

                        <Border Grid.Row="2"
                                Margin="0,16,0,0"
                                Padding="12"
                                Background="#181818"
                                BorderBrush="#333333"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="Small Pen Size" />
                                    <TextBox x:Name="PenSizeSmallTextBox" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="Medium Pen Size" />
                                    <TextBox x:Name="PenSizeMediumTextBox" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="Large Pen Size" />
                                    <TextBox x:Name="PenSizeLargeTextBox" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3"
                                Margin="0,16,0,0"
                                Padding="12"
                                Background="#181818"
                                BorderBrush="#333333"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Foreground="#F1F1F1" FontWeight="SemiBold" Text="FFmpeg Path" />
                                    <TextBox x:Name="FfmpegPathTextBox" Margin="0,4,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Width="96"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Content="Browse..."
                                                Click="BrowseFfmpegButton_OnClick" />
                                        <Button Width="126"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Content="Auto Detect"
                                                Click="AutoDetectFfmpegButton_OnClick" />
                                    </StackPanel>
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="#D3D3D3"
                                               TextWrapping="Wrap"
                                               Text="Revie bundles ffmpeg.exe by default. Leave this as 'ffmpeg' unless you need to override with a custom executable path." />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Foreground="#F1F1F1"
                                               FontWeight="SemiBold"
                                               Text="Microphone Input (Windows, use 'none' to disable)" />
                                    <ComboBox x:Name="MicrophoneDeviceComboBox"
                                              Margin="0,4,0,8"
                                              IsEditable="False"
                                              IsTextSearchEnabled="True" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Width="118"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Content="Refresh Inputs"
                                                Click="RefreshMicrophonesButton_OnClick" />
                                    </StackPanel>
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="#D3D3D3"
                                               TextWrapping="Wrap"
                                               Text="Detected from Windows microphone devices through ffmpeg. If no inputs appear, keep 'Default microphone' and Revie will still attempt audio capture." />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Hotkeys">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.ColumnSpan="3"
                                   Margin="0,0,0,10"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="Use format Ctrl+Shift+Key (example: Ctrl+Shift+D)." />

                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Foreground="{StaticResource MutedBrush}" Text="Toggle Drawing" />
                            <TextBox x:Name="ToggleDrawingHotkeyTextBox" Margin="0,4,0,10" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Foreground="{StaticResource MutedBrush}" Text="Clear Overlay" />
                            <TextBox x:Name="ClearOverlayHotkeyTextBox" Margin="0,4,0,10" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Foreground="{StaticResource MutedBrush}" Text="Capture Screenshot" />
                            <TextBox x:Name="CaptureHotkeyTextBox" Margin="0,4,0,10" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Foreground="{StaticResource MutedBrush}" Text="Open Main Window" />
                            <TextBox x:Name="OpenMainHotkeyTextBox" Margin="0,4,0,10" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0">
                            <TextBlock Foreground="{StaticResource MutedBrush}" Text="Start Video Capture" />
                            <TextBox x:Name="StartVideoHotkeyTextBox" Margin="0,4,0,10" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2">
                            <TextBlock Foreground="{StaticResource MutedBrush}" Text="Stop Video Capture" />
                            <TextBox x:Name="StopVideoHotkeyTextBox" Margin="0,4,0,10" />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Projects">
                    <Grid Margin="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Padding="16"
                                Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Project Groups" />
                                    <TextBlock Margin="0,3,0,10"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="Create named groups to keep captures organized and filterable." />
                                </StackPanel>
                                <ListBox x:Name="ProjectsListBox" Grid.Row="1" Margin="0,2,0,0" />
                            </Grid>
                        </Border>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Padding="14"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Manage Projects" />
                                    <TextBlock Margin="0,3,0,8"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="Add a new project, or remove the selected one from the list." />
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="Project Name" />
                                    <TextBox x:Name="NewProjectTextBox" Margin="0,4,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Width="106"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Content="Add Project"
                                                Click="AddProjectButton_OnClick" />
                                        <Button Width="106"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Content="Remove Selected"
                                                Click="RemoveProjectButton_OnClick" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2"
                                    Padding="14"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Active Capture Project" />
                                    <TextBlock Margin="0,3,0,8"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="New screenshots are saved into this project by default." />
                                    <ComboBox x:Name="ActiveProjectComboBox" Margin="0,2,0,0" />
                                    <TextBlock Margin="0,10,0,0"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Text="You can still reassign existing captures from the Notes panel in the main browser." />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Users">
                    <Grid Margin="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Padding="16"
                                Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Users" />
                                    <TextBlock Margin="0,3,0,10"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="Create users for ownership tagging and filtering." />
                                </StackPanel>
                                <ListBox x:Name="UsersListBox" Grid.Row="1" Margin="0,2,0,0" />
                            </Grid>
                        </Border>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Padding="14"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Manage Users" />
                                    <TextBlock Margin="0,3,0,8"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="Add a user, or remove the selected one from the list." />
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="User Name" />
                                    <TextBox x:Name="NewUserTextBox" Margin="0,4,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Width="106"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Content="Add User"
                                                Click="AddUserButton_OnClick" />
                                        <Button Width="106"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Content="Remove Selected"
                                                Click="RemoveUserButton_OnClick" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2"
                                    Padding="14"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Active Capture User" />
                                    <TextBlock Margin="0,3,0,8"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="New screenshots are tagged with this user by default." />
                                    <ComboBox x:Name="ActiveUserComboBox" Margin="0,2,0,0" />
                                    <TextBlock Margin="0,10,0,0"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Text="You can still reassign ownership from the Notes panel in both browser views." />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>

        <TextBlock x:Name="ErrorTextBlock"
                   Grid.Row="2"
                   Margin="2,12,0,0"
                   Foreground="#FF8A8A"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="3" Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="100" Margin="0,0,10,0" Style="{StaticResource PrimaryButtonStyle}" Content="Cancel" Click="CancelButton_OnClick" />
            <Button Width="100" Style="{StaticResource PrimaryButtonStyle}" Content="Save" Click="SaveButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
