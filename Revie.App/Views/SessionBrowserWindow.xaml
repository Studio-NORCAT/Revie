<Window x:Class="Revie.App.Views.SessionBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Revie.App.Infrastructure"
        Title="Sessions"
        Icon="/Assets/revie.ico"
        Width="1360"
        Height="860"
        MinWidth="920"
        MinHeight="620"
        Background="#0C0C0C"
        Foreground="#EAEAEA"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <infra:SafeImagePathConverter x:Key="SafeImagePathConverter" />
        <infra:WidthOffsetConverter x:Key="WidthOffsetConverter" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#121212" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#181818" />
        <SolidColorBrush x:Key="ControlBrush" Color="#222222" />
        <SolidColorBrush x:Key="BorderBrush" Color="#373737" />
        <SolidColorBrush x:Key="MutedBrush" Color="#B5B5B5" />

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="Foreground" Value="#F0F0F0" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2D2D2D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#171717" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E9E9E9" />
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2E2E2E" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3B3B3B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="Foreground" Value="#ECECEC" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboRoot"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7" />
                            <Grid Margin="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Margin="10,0,4,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                <Border Grid.Column="1" Background="#282828" CornerRadius="0,6,6,0">
                                    <TextBlock Text="&#xE70D;"
                                               FontFamily="Segoe MDL2 Assets"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="#D7D7D7" />
                                </Border>
                            </Grid>
                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Margin="0,6,0,0"
                                        Background="#181818"
                                        BorderBrush="#3F3F3F"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="260" CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboRoot" Property="BorderBrush" Value="#5C5C5C" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboRoot" Property="BorderBrush" Value="#727272" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboRoot" Property="BorderBrush" Value="#8F8F8F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InlineDeleteButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="#ECECEC" />
            <Setter Property="Background" Value="#262626" />
            <Setter Property="BorderBrush" Value="#454545" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#303030" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#181818" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VideoTransportButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Background" Value="#1F1F1F" />
            <Setter Property="Foreground" Value="#EFEFEF" />
            <Setter Property="BorderBrush" Value="#3F3F3F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2D2D2D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#171717" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VideoSeekSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="20" />
            <Setter Property="Foreground" Value="#9C9C9C" />
            <Setter Property="Background" Value="#1A1A1A" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="SessionListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Width"
                    Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource WidthOffsetConverter}, ConverterParameter=22}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="#1C1C1C"
                                BorderBrush="#353535"
                                BorderThickness="1"
                                CornerRadius="9">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#272727" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#313131" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#7B7B7B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThumbnailStripItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="#1E1E1E"
                                BorderBrush="#353535"
                                BorderThickness="1"
                                CornerRadius="7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2A2A2A" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#353535" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#7A7A7A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetadataChipStyle" TargetType="Border">
            <Setter Property="Background" Value="#262626" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Margin" Value="0,0,8,6" />
        </Style>

        <Style x:Key="PaneTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="LoadingSpinnerRingStyle" TargetType="Grid">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform CenterX="16" CenterY="16" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)"
                                             From="0"
                                             To="360"
                                             Duration="0:0:0.9" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="Foreground" Value="#ECECEC" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TextBoxRoot" Property="BorderBrush" Value="#5A5A5A" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxRoot" Property="BorderBrush" Value="#6F6F6F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="SessionWindowRootGrid" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="SessionTopRow" Height="Auto" />
            <RowDefinition x:Name="SessionContentRow" Height="*" />
            <RowDefinition x:Name="SessionBottomRow" Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="SessionHeaderBorder"
                Grid.Row="0"
                Margin="0,0,0,12"
                Padding="10"
                Background="#121212"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Width="88" Content="Back" Click="BackButton_OnClick" IsEnabled="{Binding IsInCaptureMode}" />
                    <TextBlock Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               Text="{Binding HeaderTitle}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="700" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="124" Margin="0,0,8,0" Content="{Binding OpenButtonText}" Click="OpenButton_OnClick" IsEnabled="{Binding CanOpen}" />
                    <Button Width="100" Content="Refresh" Click="RefreshButton_OnClick" />
                </StackPanel>
                </DockPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SessionLeftColumn" Width="0.7*" />
                <ColumnDefinition x:Name="SessionSpacerColumn" Width="12" />
                <ColumnDefinition x:Name="SessionRightColumn" Width="2.3*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource PaneTitleStyle}" Text="{Binding LeftPaneTitle}" />

                    <Border Grid.Row="1"
                            Margin="0,10,0,0"
                            Padding="10"
                            Background="#171717"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="Project Filter" />
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding SessionProjectFilterChoices}"
                                      SelectedItem="{Binding SelectedSessionProjectFilter, Mode=TwoWay}" />
                            <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="User Filter" />
                            <ComboBox Grid.Column="6"
                                      ItemsSource="{Binding SessionUserFilterChoices}"
                                      SelectedItem="{Binding SelectedSessionUserFilter, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <ListBox x:Name="SessionListBox"
                                 ItemsSource="{Binding Sessions}"
                                 SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                                 PreviewMouseRightButtonDown="SessionListBox_OnPreviewMouseRightButtonDown"
                                 MouseDoubleClick="SessionListBox_OnMouseDoubleClick"
                                 Padding="2,2,0,0"
                                 Margin="0"
                                 ClipToBounds="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.CacheLength="1"
                                 VirtualizingPanel.CacheLengthUnit="Page"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 ItemContainerStyle="{StaticResource SessionListItemStyle}">
                            <ListBox.ContextMenu>
                                <ContextMenu Opened="SessionContextMenu_OnOpened">
                                    <MenuItem Header="Assign Project" Tag="sessionProjectRoot" />
                                    <Separator />
                                    <MenuItem Header="Add User Tag" Tag="sessionUserRoot" />
                                    <MenuItem Header="Clear User Tags" Click="ClearSessionUsersFromContextMenu_OnClick" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInCaptureMode}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="84"
                                                Height="56"
                                                CornerRadius="6"
                                                Background="#232323"
                                                BorderBrush="#3A3A3A"
                                                BorderThickness="1"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Image Stretch="UniformToFill"
                                                       Source="{Binding PreviewImagePath, IsAsync=True}" />
                                                <Border Background="#A00F0F0F">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasPreview}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="No Preview"
                                                               Foreground="#B8B8B8"
                                                               FontSize="11"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFFFFF"
                                                       Text="{Binding SessionName}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <WrapPanel Margin="0,7,0,0">
                                                <Border Style="{StaticResource MetadataChipStyle}">
                                                    <TextBlock FontSize="11"
                                                               Foreground="#CFCFCF"
                                                               Text="{Binding ProjectDisplay}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="130" />
                                                </Border>
                                                <Border Style="{StaticResource MetadataChipStyle}">
                                                    <TextBlock FontSize="11"
                                                               Foreground="#CFCFCF"
                                                               Text="{Binding UserDisplay}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="160" />
                                                </Border>
                                                <Border Style="{StaticResource MetadataChipStyle}">
                                                    <TextBlock FontSize="11" Foreground="#B8B8B8" Text="{Binding TimeLabel}" />
                                                </Border>
                                                <Border Style="{StaticResource MetadataChipStyle}">
                                                    <TextBlock FontSize="11" Foreground="#CFCFCF" Text="{Binding CaptureCount, StringFormat='{}{0} capture(s)'}" />
                                                </Border>
                                                <Border Style="{StaticResource MetadataChipStyle}"
                                                        Background="#4C7A1414"
                                                        BorderBrush="#A44D4D"
                                                        BorderThickness="1"
                                                        Visibility="{Binding HasUnviewedCaptures, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock FontSize="11"
                                                               Foreground="#FFD7D7"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding UnviewedCaptureCount, StringFormat='{}{0} new'}" />
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>

                                        <Button Grid.Column="4"
                                                Style="{StaticResource InlineDeleteButtonStyle}"
                                                Margin="0"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                Content="&#x2715;"
                                                ToolTip="Delete this session"
                                                Click="DeleteSessionButton_OnClick"
                                                Tag="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ListBox x:Name="CaptureListBox"
                                 ItemsSource="{Binding SessionCaptures}"
                                 SelectedItem="{Binding SelectedCapture, Mode=TwoWay}"
                                 PreviewMouseRightButtonDown="CaptureListBox_OnPreviewMouseRightButtonDown"
                                 Padding="2,2,0,0"
                                 Margin="0"
                                 ClipToBounds="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.CacheLength="1"
                                 VirtualizingPanel.CacheLengthUnit="Page"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 ItemContainerStyle="{StaticResource SessionListItemStyle}">
                            <ListBox.ContextMenu>
                                <ContextMenu Opened="CaptureContextMenu_OnOpened">
                                    <MenuItem Header="Assign Project" Tag="projectRoot" />
                                    <Separator />
                                    <MenuItem Header="Add User Tag" Tag="userRoot" />
                                    <MenuItem Header="Clear User Tags" Click="ClearCaptureUsersFromContextMenu_OnClick" />
                                    <Separator />
                                    <MenuItem Header="Set Review State">
                                        <MenuItem Header="In Review"
                                                  Click="SetCaptureReviewStateInReview_OnClick" />
                                        <MenuItem Header="Completed"
                                                  Click="SetCaptureReviewStateCompleted_OnClick" />
                                        <MenuItem Header="Clear State"
                                                  Click="ClearCaptureReviewState_OnClick" />
                                    </MenuItem>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInCaptureMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="84" Height="56" CornerRadius="5" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail, IsAsync=True}" Stretch="UniformToFill" />
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom"
                                                            Margin="0,0,4,4">
                                                    <Border Background="#BB0F0F0F"
                                                            BorderBrush="#555555"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="4,1"
                                                            Margin="0,0,4,0">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="10"
                                                                   Foreground="#E5E5E5"
                                                                   Text="{Binding CaptureTypeGlyph}" />
                                                    </Border>
                                                    <Border Background="#BB0F0F0F"
                                                            BorderBrush="#555555"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="4,1"
                                                            Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="10"
                                                                   Foreground="#E5E5E5"
                                                                   Text="&#xE70B;" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontWeight="SemiBold" Foreground="#B8B8B8" Text="{Binding TimeLabel}" />
                                                <Border Width="10"
                                                        Height="10"
                                                        Margin="8,4,0,0"
                                                        CornerRadius="5"
                                                        Visibility="{Binding IsInReview, Converter={StaticResource BoolToVisibility}}"
                                                        Background="#D6B44D"
                                                        ToolTip="In Review" />
                                                <Border Width="10"
                                                        Height="10"
                                                        Margin="6,4,0,0"
                                                        CornerRadius="5"
                                                        Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}"
                                                        Background="#48BB6A"
                                                        ToolTip="Completed" />
                                            </StackPanel>
                                            <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Text="{Binding ActiveWindowTitle}" />
                                            <TextBlock Margin="0,2,0,0" Foreground="#A5A5A5" TextTrimming="CharacterEllipsis" Text="{Binding ProjectDisplay}" />
                                            <TextBlock Margin="0,2,0,0" Foreground="#999999" TextTrimming="CharacterEllipsis" Text="{Binding AssignedUserDisplay}" />
                                            <TextBlock Margin="0,2,0,0" Foreground="#8F8F8F" Text="{Binding CaptureTypeDisplay}" />
                                            <TextBlock Margin="0,2,0,0" Foreground="#8F8F8F" Text="{Binding ReviewStateDisplay}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Background="#780E0E0E"
                                CornerRadius="8"
                                Visibility="{Binding LeftEmptyVisible, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#E6E6E6" Text="Nothing to show" />
                                <TextBlock Margin="0,6,0,0" Foreground="#BDBDBD" Text="{Binding LeftEmptyMessage}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                MinWidth="116"
                                Margin="10,0,0,0"
                                Padding="12,6"
                                Content="{Binding CaptureDetailsToggleText}"
                                Visibility="{Binding IsInCaptureMode, Converter={StaticResource BoolToVisibility}}"
                                Click="ToggleCaptureDetailsButton_OnClick" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource PaneTitleStyle}" Text="{Binding RightPaneTitle}" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="{Binding RightPaneSubtitle}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid x:Name="SessionModeGrid">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInCaptureMode}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Padding="10"
                                    Background="#151515"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Center"
                                               Foreground="#CECECE"
                                               Text="Preview media from the selected session" />
                                    <TextBlock Grid.Column="2"
                                               VerticalAlignment="Center"
                                               Foreground="#A9A9A9"
                                               Text="{Binding SelectedSession.CaptureCount, StringFormat='{}{0} capture(s)'}" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="1"
                                    Margin="0,10,0,0"
                                    Padding="10"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <ItemsControl ItemsSource="{Binding SessionPreviewCaptures}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="170"
                                                        Height="116"
                                                        Margin="0,0,10,10"
                                                        Background="#1F1F1F"
                                                        BorderBrush="#3B3B3B"
                                                        BorderThickness="1"
                                                        CornerRadius="7"
                                                        ClipToBounds="True">
                                                    <Grid>
                                                        <Image Source="{Binding Thumbnail, IsAsync=True}" Stretch="UniformToFill" />
                                                        <Border VerticalAlignment="Bottom" Background="#9C111111" Padding="6,3">
                                                            <TextBlock Foreground="#D0D0D0" FontSize="11" Text="{Binding TimeLabel}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding SessionPreviewEmptyVisible, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#E5E5E5" Text="No media available" HorizontalAlignment="Center" />
                                        <TextBlock Margin="0,6,0,0" Foreground="#BDBDBD" Text="{Binding SessionPreviewEmptyMessage}" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <Border Background="#B2141414"
                                            CornerRadius="8"
                                            Visibility="{Binding IsLoadingSessionPreview, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid Width="28" Height="28" Margin="0,0,0,8" Style="{StaticResource LoadingSpinnerRingStyle}">
                                                <Ellipse Stroke="#343434" StrokeThickness="3" />
                                                <Path Data="M 14,2 A 12,12 0 0 1 26,14"
                                                      Stroke="#EAEAEA"
                                                      StrokeThickness="3"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" />
                                            </Grid>
                                            <TextBlock Foreground="#E3E3E3" FontWeight="SemiBold" Text="Loading previews..." />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid x:Name="CaptureModeGrid">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInCaptureMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0"
                                    Grid.Column="0"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8">
                                <Grid x:Name="SessionPreviewContentGrid"
                                      MouseMove="SessionPreviewContentGrid_OnMouseMove"
                                      MouseLeave="SessionPreviewContentGrid_OnMouseLeave">
                                    <ScrollViewer x:Name="SessionPreviewScrollViewer"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Auto"
                                                  CanContentScroll="False"
                                                  HorizontalContentAlignment="Center"
                                                  VerticalContentAlignment="Center"
                                                  PreviewMouseWheel="SessionPreviewScrollViewer_OnPreviewMouseWheel"
                                                  PreviewMouseLeftButtonDown="SessionPreviewScrollViewer_OnMouseLeftButtonDown"
                                                  PreviewMouseMove="SessionPreviewScrollViewer_OnMouseMove"
                                                  PreviewMouseLeftButtonUp="SessionPreviewScrollViewer_OnMouseLeftButtonUp"
                                                  MouseLeave="SessionPreviewScrollViewer_OnMouseLeave"
                                                  SizeChanged="SessionPreviewScrollViewer_OnSizeChanged">
                                        <ScrollViewer.Style>
                                            <Style TargetType="ScrollViewer">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelectedCaptureVideo}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ScrollViewer.Style>
                                        <Grid Background="Transparent">
                                            <Image x:Name="SessionPreviewImage"
                                                   Source="{Binding SelectedCapture.PreviewImage, IsAsync=True}"
                                                   Stretch="None"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                                <Image.LayoutTransform>
                                                    <ScaleTransform ScaleX="{Binding PreviewScale}" ScaleY="{Binding PreviewScale}" />
                                                </Image.LayoutTransform>
                                            </Image>
                                        </Grid>
                                    </ScrollViewer>

                                    <Border Background="Transparent">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelectedCaptureVideo}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <MediaElement x:Name="SessionVideoPreviewElement"
                                                      LoadedBehavior="Manual"
                                                      UnloadedBehavior="Manual"
                                                      ScrubbingEnabled="True"
                                                      Stretch="Uniform"
                                                      MediaOpened="SessionVideoPreviewElement_OnMediaOpened"
                                                      MediaEnded="SessionVideoPreviewElement_OnMediaEnded"
                                                      MediaFailed="SessionVideoPreviewElement_OnMediaFailed" />
                                    </Border>

                                    <Border x:Name="SessionVideoToolbarBorder"
                                            Visibility="{Binding IsSelectedCaptureVideo, Converter={StaticResource BoolToVisibility}}"
                                            VerticalAlignment="Bottom"
                                            Margin="10"
                                            Padding="10,8"
                                            Background="#B8141414"
                                            BorderBrush="#3A3A3A"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Opacity="1"
                                            MouseEnter="SessionVideoToolbarBorder_OnMouseEnter"
                                            MouseLeave="SessionVideoToolbarBorder_OnMouseLeave">
                                        <StackPanel>
                                            <Slider x:Name="SessionVideoSeekSlider"
                                                    Style="{StaticResource VideoSeekSliderStyle}"
                                                    Minimum="0"
                                                    Maximum="1"
                                                    Value="0"
                                                    ValueChanged="SessionVideoSeekSlider_OnValueChanged"
                                                    PreviewMouseLeftButtonDown="SessionVideoSeekSlider_OnPreviewMouseLeftButtonDown"
                                                    PreviewMouseLeftButtonUp="SessionVideoSeekSlider_OnPreviewMouseLeftButtonUp"
                                                    LostMouseCapture="SessionVideoSeekSlider_OnLostMouseCapture" />
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="SessionVideoTimeTextBlock"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Foreground="#D8D8D8"
                                                           FontSize="12"
                                                           Text="00:00 / 00:00" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Style="{StaticResource VideoTransportButtonStyle}"
                                                            Margin="0,0,8,0"
                                                            Content="&#xE768;"
                                                            ToolTip="Play"
                                                            Click="SessionVideoPlayButton_OnClick" />
                                                    <Button Style="{StaticResource VideoTransportButtonStyle}"
                                                            Margin="0,0,8,0"
                                                            Content="&#xE769;"
                                                            ToolTip="Pause"
                                                            Click="SessionVideoPauseButton_OnClick" />
                                                    <Button Style="{StaticResource VideoTransportButtonStyle}"
                                                            Margin="0,0,8,0"
                                                            Content="&#xE71A;"
                                                            ToolTip="Stop"
                                                            Click="SessionVideoStopButton_OnClick" />
                                                    <Button Style="{StaticResource VideoTransportButtonStyle}"
                                                            Content="&#xE777;"
                                                            ToolTip="Restart"
                                                            Click="SessionVideoRestartButton_OnClick" />
                                                </StackPanel>
                                                <Button x:Name="SessionVideoFullscreenButton"
                                                        Grid.Column="2"
                                                        Style="{StaticResource VideoTransportButtonStyle}"
                                                        Content="&#xE740;"
                                                        ToolTip="Fullscreen preview"
                                                        Click="SessionVideoFullscreenButton_OnClick" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#780F0F0F"
                                            CornerRadius="8"
                                            Visibility="{Binding EmptyRightPaneVisible, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#E6E6E6" Text="Nothing selected" HorizontalAlignment="Center" />
                                            <TextBlock Margin="0,6,0,0" Foreground="#BDBDBD" Text="{Binding EmptyRightPaneMessage}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,10,0,0"
                                    Padding="10"
                                    Background="#151515"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="{Binding IsCaptureDetailsVisible, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" MaxWidth="380">
                                        <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="Captured At" />
                                        <TextBlock Margin="0,3,0,10" Foreground="#C8C8C8" Text="{Binding SelectedCapture.FullTimestampLabel}" />

                                        <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="Window" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Foreground="#D7D7D7"
                                                   TextWrapping="WrapWithOverflow"
                                                   Text="{Binding SelectedCapture.ActiveWindowTitle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="User" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,8">
                                            <ComboBox Width="160"
                                                      Margin="0,0,8,0"
                                                      ItemsSource="{Binding SessionUserChoices}"
                                                      SelectedItem="{Binding SelectedCaptureUserChoice, Mode=TwoWay}" />
                                            <Button MinWidth="84"
                                                    MinHeight="34"
                                                    Padding="12,6"
                                                    Content="Assign"
                                                    Click="AssignCaptureUserButton_OnClick" />
                                        </StackPanel>
                                        <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="User Tags (comma separated)" />
                                        <TextBox Margin="0,3,0,8"
                                                 Text="{Binding SelectedCapture.UserTagsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="Notes" />
                                        <TextBox x:Name="SessionCaptureNoteTextBox"
                                                  Height="100"
                                                 Margin="0,3,0,0"
                                                 Text="{Binding SelectedCapture.Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalContentAlignment="Top"
                                                 VerticalScrollBarVisibility="Auto"
                                                 TextChanged="SessionCaptureNoteTextBox_OnTextChanged" />

                                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Border x:Name="SessionNoteSavedBadge"
                                                    Margin="0,0,8,0"
                                                    Padding="10,5"
                                                    VerticalAlignment="Center"
                                                    Background="#1E5B2A"
                                                    BorderBrush="#3F9A57"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Visibility="{Binding IsSessionNoteSavedVisible, Converter={StaticResource BoolToVisibility}}"
                                                    Opacity="0">
                                                <TextBlock Foreground="#D9FFE3"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Center"
                                                           Text="Saved" />
                                            </Border>
                                            <Button MinWidth="96"
                                                    MinHeight="34"
                                                    Padding="12,6"
                                                    Content="Save Note"
                                                    Click="SaveCaptureNoteButton_OnClick" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="SessionFooterBorder"
                Grid.Row="2"
                Margin="0,10,0,0"
                Padding="10,7"
                Background="#151515"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Foreground="{StaticResource MutedBrush}"
                           Text="{Binding StatusText}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="620" />
                <Border DockPanel.Dock="Right"
                        Padding="10,6"
                        Background="#1B1B1B"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInCaptureMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="Project" />
                        <ComboBox Width="170"
                                  Margin="0,0,12,0"
                                  ItemsSource="{Binding SessionProjectFilterChoices}"
                                  SelectedItem="{Binding SelectedSessionProjectFilter, Mode=TwoWay}" />
                        <TextBlock Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="User" />
                        <ComboBox Width="170"
                                  ItemsSource="{Binding SessionUserFilterChoices}"
                                  SelectedItem="{Binding SelectedSessionUserFilter, Mode=TwoWay}" />
                    </WrapPanel>
                </Border>
                </DockPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="0"
                Grid.RowSpan="3"
                Panel.ZIndex="200"
                Background="#A8090909"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="340"
                    MaxWidth="460"
                    Padding="18"
                    Background="#171717"
                    BorderBrush="#3C3C3C"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel>
                    <Grid Width="32" Height="32" Margin="0,0,0,10" Style="{StaticResource LoadingSpinnerRingStyle}">
                        <Ellipse Stroke="#343434" StrokeThickness="3" />
                        <Path Data="M 16,2 A 14,14 0 0 1 30,16"
                              Stroke="#EAEAEA"
                              StrokeThickness="3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Grid>
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="#F0F0F0"
                               FontWeight="SemiBold"
                               Text="Processing..." />
                    <TextBlock Margin="0,6,0,8"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               Text="{Binding StatusText}" />
                    <ProgressBar Height="6" IsIndeterminate="True" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>

