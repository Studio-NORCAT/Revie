<Window x:Class="Revie.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Revie"
        Icon="/Assets/revie.ico"
        Width="1460"
        Height="920"
        MinWidth="1200"
        MinHeight="780"
        Background="#0A0A0A"
        Foreground="#E6E6E6"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#111111" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#171717" />
        <SolidColorBrush x:Key="ControlBrush" Color="#1F1F1F" />
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#2A2A2A" />
        <SolidColorBrush x:Key="ControlPressedBrush" Color="#141414" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3A3A3A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#B5B5B5" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7B7B7B" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#3A3A3A" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#A5A5A5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarActionButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="MinHeight" Value="42" />
        </Style>

        <Style x:Key="ToolbarActionToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource PrimaryToggleButtonStyle}">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="MinHeight" Value="42" />
        </Style>

        <Style x:Key="ToolbarGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#DADADA" />
        </Style>

        <Style x:Key="ToolbarLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#EFEFEF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="RecordingDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Fill" Value="#E44343" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Opacity" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSessionActive}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="RecordingPulseStoryboard">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1"
                                                 To="0.25"
                                                 Duration="0:0:0.65" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="RecordingPulseStoryboard" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VideoRecordingDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Fill" Value="#E44343" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Opacity" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVideoRecording}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="VideoRecordingPulseStoryboard">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1"
                                                 To="0.25"
                                                 Duration="0:0:0.65" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="VideoRecordingPulseStoryboard" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E9E9E9" />
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2E2E2E" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3B3B3B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="Foreground" Value="#ECECEC" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboRoot"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" />
                            <Grid Margin="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Margin="10,0,4,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                <Border Grid.Column="1" Background="#272727" CornerRadius="0,7,7,0">
                                    <TextBlock Text="&#xE70D;"
                                               FontFamily="Segoe MDL2 Assets"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="#D7D7D7" />
                                </Border>
                            </Grid>
                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Margin="0,6,0,0"
                                        Background="#181818"
                                        BorderBrush="#3F3F3F"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="280" CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboRoot" Property="BorderBrush" Value="#595959" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboRoot" Property="BorderBrush" Value="#6A6A6A" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboRoot" Property="BorderBrush" Value="#8F8F8F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboRoot" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="Foreground" Value="#ECECEC" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TextBoxRoot" Property="BorderBrush" Value="#5B5B5B" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxRoot" Property="BorderBrush" Value="#707070" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TextBoxRoot" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="LoadingSpinnerRingStyle" TargetType="Grid">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform CenterX="16" CenterY="16" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)"
                                             From="0"
                                             To="360"
                                             Duration="0:0:0.9" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style x:Key="VideoTransportButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Background" Value="#1F1F1F" />
            <Setter Property="BorderBrush" Value="#3D3D3D" />
        </Style>

        <Style x:Key="VideoSeekSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="20" />
            <Setter Property="Foreground" Value="#9C9C9C" />
            <Setter Property="Background" Value="#1A1A1A" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="InlineDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="#ECECEC" />
            <Setter Property="Background" Value="#222222" />
            <Setter Property="BorderBrush" Value="#434343" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                CornerRadius="13"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2C2C2C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#181818" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="#1F1F1F"
                                BorderBrush="#353535"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#282828" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2F2F2F" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainWindowRootGrid" Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MainPreviewColumn" Width="*" />
            <ColumnDefinition x:Name="MainSplitterColumn" Width="12" />
            <ColumnDefinition x:Name="MainSidebarColumn" Width="390" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="MainContentRow" Height="*" />
            <RowDefinition x:Name="MainStatusRow" Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="MainTopToolbarRow" Height="Auto" />
                    <RowDefinition x:Name="MainFilterSummaryRow" Height="Auto" />
                    <RowDefinition x:Name="MainPreviewRow" Height="*" />
                    <RowDefinition x:Name="MainPreviewActionsRow" Height="Auto" />
                    <RowDefinition x:Name="MainNotesRow" Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Border
                            Padding="8"
                            CornerRadius="10"
                            Background="#141414"
                            BorderBrush="#2F2F2F"
                            BorderThickness="1">
                        <DockPanel LastChildFill="False">
                        <ToggleButton x:Name="SearchToggleButton"
                                      DockPanel.Dock="Left"
                                      Style="{StaticResource ToolbarActionToggleButtonStyle}"
                                      Margin="0,0,10,0"
                                      ToolTip="Search">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource ToolbarGlyphStyle}" Text="&#xE721;" />
                                <TextBlock Grid.Column="2" Style="{StaticResource ToolbarLabelStyle}" Text="Search" />
                            </Grid>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ToolbarActionToggleButtonStyle}"
                                      DockPanel.Dock="Right"
                                      IsChecked="{Binding IsNotesVisible, Mode=TwoWay}"
                                      ToolTip="Notes">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource ToolbarGlyphStyle}" Text="&#xE70B;" />
                                <TextBlock Grid.Column="2" Style="{StaticResource ToolbarLabelStyle}" Text="Notes" />
                            </Grid>
                        </ToggleButton>
                        </DockPanel>
                    </Border>
                </DockPanel>

                <Border Grid.Row="1" Margin="0,10,0,10" Padding="10,6" Background="#191919" CornerRadius="8" BorderBrush="#333333" BorderThickness="1">
                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding ActiveFilterSummary}" />
                </Border>

                <Border Grid.Row="2"
                        Background="#080808"
                        BorderBrush="#2F2F2F"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8">
                    <Grid x:Name="PreviewContentGrid"
                          MouseMove="PreviewContentGrid_OnMouseMove"
                          MouseLeave="PreviewContentGrid_OnMouseLeave">
                        <ScrollViewer x:Name="PreviewScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="PreviewScrollViewer_OnPreviewMouseWheel"
                                      PreviewMouseLeftButtonDown="PreviewScrollViewer_OnMouseLeftButtonDown"
                                      PreviewMouseMove="PreviewScrollViewer_OnMouseMove"
                                      PreviewMouseLeftButtonUp="PreviewScrollViewer_OnMouseLeftButtonUp"
                                      MouseLeave="PreviewScrollViewer_OnMouseLeave">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelectedCaptureVideo}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <Grid Background="Transparent">
                                <Image x:Name="PreviewImage"
                                       Source="{Binding SelectedCapture.PreviewImage}"
                                       Stretch="None"
                                       SnapsToDevicePixels="True"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Opacity" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPreviewLoading}" Value="True">
                                                    <Setter Property="Opacity" Value="0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                    <Image.LayoutTransform>
                                        <ScaleTransform ScaleX="{Binding PreviewScale}" ScaleY="{Binding PreviewScale}" />
                                    </Image.LayoutTransform>
                                </Image>
                            </Grid>
                        </ScrollViewer>

                        <Border Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelectedCaptureVideo}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <MediaElement x:Name="VideoPreviewElement"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Manual"
                                          ScrubbingEnabled="True"
                                          Stretch="Uniform"
                                          MediaOpened="VideoPreviewElement_OnMediaOpened"
                                          MediaEnded="VideoPreviewElement_OnMediaEnded"
                                          MediaFailed="VideoPreviewElement_OnMediaFailed" />
                        </Border>

                        <Border x:Name="VideoToolbarBorder"
                                Visibility="{Binding IsSelectedCaptureVideo, Converter={StaticResource BooleanToVisibilityConverter}}"
                                VerticalAlignment="Bottom"
                                Margin="10"
                                Padding="10,8"
                                Background="#B8141414"
                                BorderBrush="#3A3A3A"
                                BorderThickness="1"
                                CornerRadius="8"
                                Opacity="1"
                                MouseEnter="VideoToolbarBorder_OnMouseEnter"
                                MouseLeave="VideoToolbarBorder_OnMouseLeave">
                            <StackPanel>
                                <Slider x:Name="VideoSeekSlider"
                                        Style="{StaticResource VideoSeekSliderStyle}"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="0"
                                        ValueChanged="VideoSeekSlider_OnValueChanged"
                                        PreviewMouseLeftButtonDown="VideoSeekSlider_OnPreviewMouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="VideoSeekSlider_OnPreviewMouseLeftButtonUp"
                                        LostMouseCapture="VideoSeekSlider_OnLostMouseCapture" />
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="VideoTimeTextBlock"
                                               Grid.Column="0"
                                               VerticalAlignment="Center"
                                               Foreground="#D8D8D8"
                                               FontSize="12"
                                               Text="00:00 / 00:00" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource VideoTransportButtonStyle}"
                                                Margin="0,0,8,0"
                                                Content="&#xE768;"
                                                ToolTip="Play"
                                                Click="VideoPlayButton_OnClick" />
                                        <Button Style="{StaticResource VideoTransportButtonStyle}"
                                                Margin="0,0,8,0"
                                                Content="&#xE769;"
                                                ToolTip="Pause"
                                                Click="VideoPauseButton_OnClick" />
                                        <Button Style="{StaticResource VideoTransportButtonStyle}"
                                                Margin="0,0,8,0"
                                                Content="&#xE71A;"
                                                ToolTip="Stop"
                                                Click="VideoStopButton_OnClick" />
                                        <Button Style="{StaticResource VideoTransportButtonStyle}"
                                                Content="&#xE777;"
                                                ToolTip="Restart"
                                                Click="VideoRestartButton_OnClick" />
                                    </StackPanel>
                                    <Button x:Name="VideoFullscreenButton"
                                            Grid.Column="2"
                                            Style="{StaticResource VideoTransportButtonStyle}"
                                            Content="&#xE740;"
                                            ToolTip="Fullscreen preview"
                                            Click="VideoFullscreenButton_OnClick" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border
                                Background="#700E0E0E"
                                CornerRadius="8"
                                IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCapture}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#E6E6E6" Text="No capture selected" />
                                <TextBlock Margin="0,6,0,0" Foreground="#BDBDBD" Text="Select a capture from Latest Captures to preview it." />
                            </StackPanel>
                        </Border>

                        <Border
                                Background="#B3121212"
                                CornerRadius="8"
                                Visibility="{Binding IsPreviewLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Margin="0,0,0,8" Foreground="#E6E6E6" Text="Loading image..." HorizontalAlignment="Center" />
                                <ProgressBar Width="220" Height="6" IsIndeterminate="True" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="3"
                        Margin="0,10,0,0"
                        Padding="8"
                        CornerRadius="8"
                        Background="#121212"
                        BorderBrush="#2D2D2D"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                MinWidth="104"
                                MinHeight="32"
                                Padding="10,6"
                                Margin="0,0,12,0"
                                Click="ResetViewButton_OnClick"
                                ToolTip="Reset View">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelectedCaptureVideo}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource ToolbarGlyphStyle}" Text="&#xE777;" />
                                <TextBlock Grid.Column="2" Style="{StaticResource ToolbarLabelStyle}" Text="Reset View" />
                            </Grid>
                        </Button>

                        <Button Grid.Column="2"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="142"
                                MinHeight="32"
                                Padding="10,6"
                                Margin="12,0,0,0"
                                Command="{Binding OpenInExplorerCommand}"
                                HorizontalAlignment="Right"
                                ToolTip="Open in Explorer">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource ToolbarGlyphStyle}" Text="&#xE838;" />
                                <TextBlock Grid.Column="2" Style="{StaticResource ToolbarLabelStyle}" Text="Open in Explorer" />
                            </Grid>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="4"
                        Margin="0,12,0,0"
                        Background="{StaticResource SurfaceAltBrush}"
                        CornerRadius="10"
                        Padding="12"
                        Visibility="{Binding IsNotesVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Window Title" />
                            <TextBlock Margin="0,0,0,10" Text="{Binding SelectedCapture.ActiveWindowTitle}" TextWrapping="Wrap" />

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Process" />
                            <TextBlock Margin="0,0,0,10" Text="{Binding SelectedCapture.ActiveProcessName}" />

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Capture Path" />
                            <TextBlock Text="{Binding SelectedCapture.CaptureDirectory}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Add User Tag" />
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox Width="190"
                                                  Margin="0,0,8,0"
                                                  ItemsSource="{Binding UserChoices}"
                                                  SelectedItem="{Binding SelectedUserChoice, Mode=TwoWay}" />
                                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                                MinWidth="76"
                                                MinHeight="34"
                                                Padding="10,6"
                                                Content="Add"
                                                Command="{Binding AssignUserCommand}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Current User Tags" />
                                    <TextBox Text="{Binding SelectedCapture.UserTagsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Project" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <ComboBox Width="200"
                                          Margin="0,0,8,0"
                                          ItemsSource="{Binding ProjectChoices}"
                                          SelectedItem="{Binding SelectedProjectChoice, Mode=TwoWay}" />
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        MinWidth="86"
                                        MinHeight="34"
                                        Padding="10,6"
                                        Content="Assign"
                                        Command="{Binding AssignProjectCommand}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Notes" />
                            <TextBox x:Name="NoteEditorTextBox"
                                     Height="120"
                                     Text="{Binding SelectedCapture.Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     TextChanged="NoteEditorTextBox_OnTextChanged" />
                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border x:Name="NoteSavedBadge"
                                        Margin="0,0,8,0"
                                        Padding="10,5"
                                        VerticalAlignment="Center"
                                        Background="#1E5B2A"
                                        BorderBrush="#3F9A57"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Opacity="0"
                                        Visibility="Collapsed">
                                    <TextBlock Foreground="#D9FFE3"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               Text="Saved" />
                                </Border>
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        MinHeight="34"
                                        MinWidth="96"
                                        Padding="10,6"
                                        Content="Save Note"
                                        Click="SaveNoteButton_OnClick" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Popup x:Name="SearchPopup"
                       PlacementTarget="{Binding ElementName=SearchToggleButton}"
                       Placement="Bottom"
                       AllowsTransparency="True"
                       StaysOpen="False"
                       IsOpen="{Binding IsChecked, ElementName=SearchToggleButton, Mode=TwoWay}">
                    <Border Width="430"
                            Margin="0,8,0,0"
                            Padding="12"
                            CornerRadius="10"
                            Background="#161616"
                            BorderBrush="#393939"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="Search &amp; Date Range" />
                            <TextBlock Margin="0,2,0,10" Foreground="{StaticResource MutedBrush}" Text="Use yyyy-MM-dd for dates." />

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Search Text" />
                            <TextBox Margin="0,0,0,10" Text="{Binding FilterSearchText, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="From" />
                                    <TextBox Text="{Binding FilterStartText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="To" />
                                    <TextBox Text="{Binding FilterEndText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Project" />
                            <ComboBox Margin="0,0,0,10"
                                      ItemsSource="{Binding FilterProjectChoices}"
                                      SelectedItem="{Binding FilterProjectChoice, Mode=TwoWay}" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="User" />
                                    <ComboBox ItemsSource="{Binding FilterUserChoices}"
                                              SelectedItem="{Binding FilterUserChoice, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="User Contains" />
                                    <TextBox Text="{Binding FilterUserText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <WrapPanel Margin="0,0,0,10">
                                <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="12,8" Content="Today" Command="{Binding SetQuickRangeCommand}" CommandParameter="today" />
                                <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="12,8" Content="Last 7 Days" Command="{Binding SetQuickRangeCommand}" CommandParameter="7d" />
                                <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="12,8" Content="Last 30 Days" Command="{Binding SetQuickRangeCommand}" CommandParameter="30d" />
                                <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8" Padding="12,8" Content="All" Command="{Binding SetQuickRangeCommand}" CommandParameter="all" />
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource PrimaryButtonStyle}" Width="96" Margin="0,0,8,0" Content="Clear" Command="{Binding ClearFiltersCommand}" />
                                <Button Style="{StaticResource PrimaryButtonStyle}" Width="96" Content="Apply" Command="{Binding ApplyFiltersCommand}" Click="ApplyFiltersButton_OnClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <Border x:Name="MainSidebarBorder"
                Grid.Row="0" Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Left"
                            Style="{StaticResource IconButtonStyle}"
                            Margin="0,0,10,0"
                            Content="&#xE72C;"
                            Command="{Binding RefreshCommand}"
                            ToolTip="Refresh" />
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Latest Captures" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="Newest first, grouped by day" />
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1"
                        Margin="0,0,0,10"
                        Padding="10"
                        Background="#181818"
                        BorderBrush="#333333"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                    Foreground="{StaticResource MutedBrush}"
                                    Text="Project" />
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding LatestProjectFilterChoices}"
                                  SelectedItem="{Binding LatestProjectFilterChoice, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <ListBox ItemsSource="{Binding CaptureView}"
                             SelectedItem="{Binding SelectedCapture, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,10,0,6"
                                                   FontWeight="SemiBold"
                                                   Foreground="#B8B8B8"
                                                   Text="{Binding Name}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="88" Height="58" CornerRadius="4" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Margin="0,0,4,4">
                                                <Border Background="#BB0F0F0F"
                                                        BorderBrush="#555555"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="4,1"
                                                        Margin="0,0,4,0">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                                               FontSize="10"
                                                               Foreground="#E5E5E5"
                                                               Text="{Binding CaptureTypeGlyph}" />
                                                </Border>
                                                <Border Background="#BB0F0F0F"
                                                        BorderBrush="#555555"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="4,1"
                                                        Visibility="{Binding HasNote, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                                               FontSize="10"
                                                               Foreground="#E5E5E5"
                                                               Text="&#xE70B;" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock FontWeight="SemiBold" Foreground="#B8B8B8" Text="{Binding TimeLabel}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding ActiveWindowTitle}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Foreground="#9D9D9D"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding ProjectDisplay}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Foreground="#909090"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding AssignedUserDisplay}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Foreground="#868686"
                                                   Text="{Binding CaptureTypeDisplay}" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource InlineDeleteButtonStyle}"
                                            Margin="0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Content="&#x2715;"
                                            ToolTip="Delete this capture"
                                            Command="{Binding DataContext.DeleteCaptureCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Padding="14"
                            Background="#1A1A1A"
                            BorderBrush="#333333"
                            BorderThickness="1"
                            CornerRadius="8"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch"
                            Visibility="{Binding HasNoVisibleCaptures, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="No captures found" />
                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" Text="Take a screenshot with Ctrl+Shift+S, or clear search filters." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="MainStatusBorder"
                Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Background="#151515" CornerRadius="8" Padding="10,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="112"
                            MinHeight="34"
                            Padding="12,7"
                            Margin="0,0,12,0"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip="Settings">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ToolbarGlyphStyle}" Text="&#xE713;" />
                            <TextBlock Grid.Column="2" Style="{StaticResource ToolbarLabelStyle}" Text="Settings" />
                        </Grid>
                    </Button>

                    <Border Background="#1A1A1A"
                            BorderBrush="#353535"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,6"
                            MinWidth="252">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       Text="Current Project" />
                            <ComboBox Grid.Column="2"
                                      MinWidth="160"
                                      ItemsSource="{Binding ActiveCaptureProjectChoices}"
                                      SelectedItem="{Binding ActiveCaptureProjectChoice, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Margin="10,0,0,0"
                            Background="#1A1A1A"
                            BorderBrush="#353535"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,6"
                            MinWidth="252"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       Text="Current User" />
                            <ComboBox Grid.Column="2"
                                      MinWidth="160"
                                      ItemsSource="{Binding ActiveCaptureUserChoices}"
                                      SelectedItem="{Binding ActiveCaptureUserChoice, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="122"
                            MinHeight="34"
                            Padding="12,7"
                            Margin="0,0,10,0"
                            Command="{Binding StartVideoCommand}"
                            ToolTip="Start a video segment">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ToolbarGlyphStyle}" Text="&#xE7C8;" />
                            <TextBlock Grid.Column="2" Style="{StaticResource ToolbarLabelStyle}" Text="Start Video" />
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="114"
                            MinHeight="34"
                            Padding="12,7"
                            Margin="0,0,10,0"
                            Command="{Binding StopVideoCommand}"
                            ToolTip="Stop current video segment">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ToolbarGlyphStyle}" Text="&#xE71A;" />
                            <TextBlock Grid.Column="2" Style="{StaticResource ToolbarLabelStyle}" Text="Stop Video" />
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="124"
                            MinHeight="34"
                            Padding="12,7"
                            Margin="0,0,10,0"
                            Command="{Binding OpenSessionsCommand}"
                            ToolTip="Open session browser">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ToolbarGlyphStyle}" Text="&#xE8B7;" />
                            <TextBlock Grid.Column="2" Style="{StaticResource ToolbarLabelStyle}" Text="Open Sessions" />
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,-8,-8,0"
                                    MinWidth="18"
                                    Height="18"
                                    Padding="4,0"
                                    CornerRadius="9"
                                    Background="#B12323"
                                    BorderBrush="#D96A6A"
                                    BorderThickness="1"
                                    Visibility="{Binding HasUnviewedSessions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#FFF3F3"
                                           Text="{Binding UnviewedSessionsBadgeText}" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="146"
                            MinHeight="34"
                            Padding="12,7"
                            Margin="0,0,10,0"
                            Command="{Binding PurgeRecentCapturesCommand}"
                            ToolTip="Delete all recent captures from the main list (sessions remain intact)">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ToolbarGlyphStyle}" Text="&#xE74D;" />
                            <TextBlock Grid.Column="2" Style="{StaticResource ToolbarLabelStyle}" Text="Purge Recent" />
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="124"
                            MinHeight="34"
                            Padding="12,7"
                            Margin="0,0,10,0"
                            Command="{Binding StartSessionCommand}"
                            ToolTip="Start a review session">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ToolbarGlyphStyle}" Text="&#xE768;" />
                            <TextBlock Grid.Column="2" Style="{StaticResource ToolbarLabelStyle}" Text="Start Session" />
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="132"
                            MinHeight="34"
                            Padding="12,7"
                            Margin="0,0,10,0"
                            Command="{Binding CancelSessionCommand}"
                            ToolTip="Cancel and discard the active session">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ToolbarGlyphStyle}" Text="&#xE711;" />
                            <TextBlock Grid.Column="2" Style="{StaticResource ToolbarLabelStyle}" Text="Cancel Session" />
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="118"
                            MinHeight="34"
                            Padding="12,7"
                            Command="{Binding SaveSessionCommand}"
                            ToolTip="Save and package the active session">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ToolbarGlyphStyle}" Text="&#xE74E;" />
                            <TextBlock Grid.Column="2" Style="{StaticResource ToolbarLabelStyle}" Text="Save Session" />
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="30,0,24,0" MinWidth="420">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">
                        <Ellipse Style="{StaticResource RecordingDotStyle}" />
                        <TextBlock Foreground="#AFAFAF" Text="{Binding SessionSummary}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">
                        <Ellipse Style="{StaticResource VideoRecordingDotStyle}" />
                        <TextBlock Foreground="#C68787" Text="{Binding VideoSummary}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Panel.ZIndex="200"
                Background="#A8090909"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="340"
                    MaxWidth="460"
                    Padding="18"
                    Background="#171717"
                    BorderBrush="#3C3C3C"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel>
                    <Grid Width="32" Height="32" Margin="0,0,0,10" Style="{StaticResource LoadingSpinnerRingStyle}">
                        <Ellipse Stroke="#343434" StrokeThickness="3" />
                        <Path Data="M 16,2 A 14,14 0 0 1 30,16"
                              Stroke="#EAEAEA"
                              StrokeThickness="3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Grid>
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="#F0F0F0"
                               FontWeight="SemiBold"
                               Text="Loading..." />
                    <TextBlock Margin="0,6,0,8"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               Text="{Binding StatusText}" />
                    <ProgressBar Height="6" IsIndeterminate="True" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
