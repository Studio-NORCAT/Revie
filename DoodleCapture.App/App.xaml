<Application x:Class="DoodleCapture.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <SolidColorBrush x:Key="ScrollbarTrackBrush" Color="#161616" />
        <SolidColorBrush x:Key="ScrollbarTrackBorderBrush" Color="#303030" />
        <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#4A4A4A" />
        <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="#646464" />
        <SolidColorBrush x:Key="ScrollbarThumbPressedBrush" Color="#787878" />
        <SolidColorBrush x:Key="CheckIndicatorFillBrush" Color="#1D1D1D" />
        <SolidColorBrush x:Key="CheckIndicatorBorderBrush" Color="#525252" />
        <SolidColorBrush x:Key="CheckIndicatorActiveBrush" Color="#2B2B2B" />
        <SolidColorBrush x:Key="CheckDotBrush" Color="#E9E9E9" />

        <Style x:Key="DarkThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="{StaticResource ScrollbarThumbBrush}" />
            <Setter Property="BorderBrush" Value="#8A8A8A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbRoot" Property="Background" Value="{StaticResource ScrollbarThumbHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbRoot" Property="Background" Value="{StaticResource ScrollbarThumbPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="MinHeight" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border x:Name="TrackRoot"
                                Background="{StaticResource ScrollbarTrackBrush}"
                                BorderBrush="{StaticResource ScrollbarTrackBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter Property="Width" Value="12" />
                                <Setter TargetName="TrackRoot" Property="Margin" Value="2,0,0,0" />
                            </Trigger>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="12" />
                                <Setter TargetName="TrackRoot" Property="Margin" Value="0,2,0,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F1F1F1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Indicator"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="4"
                                    Background="{StaticResource CheckIndicatorFillBrush}"
                                    BorderBrush="{StaticResource CheckIndicatorBorderBrush}"
                                    BorderThickness="1" />

                            <Ellipse x:Name="Dot"
                                     Width="8"
                                     Height="8"
                                     Fill="{StaticResource CheckDotBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Visibility="Collapsed" />

                            <Rectangle x:Name="IndeterminateMark"
                                       Width="8"
                                       Height="2"
                                       RadiusX="1"
                                       RadiusY="1"
                                       Fill="{StaticResource CheckDotBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />

                            <ContentPresenter Grid.Column="2"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Indicator" Property="BorderBrush" Value="#767676" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Indicator" Property="Background" Value="{StaticResource CheckIndicatorActiveBrush}" />
                                <Setter TargetName="Indicator" Property="BorderBrush" Value="#8A8A8A" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="Indicator" Property="Background" Value="{StaticResource CheckIndicatorActiveBrush}" />
                                <Setter TargetName="Indicator" Property="BorderBrush" Value="#8A8A8A" />
                                <Setter TargetName="IndeterminateMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
